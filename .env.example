# ==============================================================================
# Keycloak HA Setup – Zentrale Konfiguration
# Kopiere diese Datei als .env und befülle alle Werte vor dem Deployment.
# WICHTIG: .env wird NIEMALS committed (steht in .gitignore).
# Passwörter generieren z.B. mit: openssl rand -base64 24
# ==============================================================================

# === Domain & TLS ===
# Öffentlicher FQDN, unter dem Keycloak erreichbar ist.
# DNS muss vor 03-setup-nginx.sh auf lb01 zeigen (Certbot-Voraussetzung).
KC_DOMAIN=auth.example.com

# E-Mail für Let's Encrypt ACME-Benachrichtigungen (Ablauf-Warnungen)
ACME_EMAIL=admin@example.com

# === Admin-Console auf separater Domain (optional) ===
# Leer lassen = Admin-Console laeuft wie bisher unter KC_DOMAIN (Verhalten wie
# ohne dieses Feature). Ist ein Wert gesetzt, generiert Keycloak seine
# Admin-URLs mit dieser Domain (hostname-admin) UND Nginx sperrt /admin/ auf
# der Login-Domain mit 403 - inklusive der Admin-REST-API (/admin/realms/...).
# DNS muss auf lb01 zeigen, bevor 03-setup-nginx.sh laeuft (Certbot).
#   Test: kc-admin-test.swl-innovation.de
#   DEV:  kc-admin-dev.swl-innovation.de
#   Prod: kc-admin-prod.swl-innovation.de
KC_ADMIN_DOMAIN=

# Komma-separierte IPs/CIDRs mit Zugriff auf die Admin-Domain (leer = alle).
# Beispiel: KC_ADMIN_ALLOW_IPS=10.0.0.1,192.168.10.0/24
KC_ADMIN_ALLOW_IPS=

# === VM IPs (private/interne Netzwerk-IPs) ===
DB_HOST=10.0.1.10
KC_NODE1_IP=10.0.1.11
KC_NODE2_IP=10.0.1.12
LB_HOST=10.0.1.13

# === PostgreSQL ===
DB_NAME=keycloak
DB_USER=keycloak
# PFLICHT: Sicheres Passwort generieren (openssl rand -base64 24)
DB_PASSWORD=

# === Keycloak ===
# Pinned Version – Änderung erfordert erneutes Ausführen von 02-setup-keycloak.sh
KC_VERSION=26.5.5

# Initialer Admin-User (wird NUR beim allerersten Start ausgewertet,
# solange noch kein Admin in der DB existiert).
KC_ADMIN_USER=admin
# PFLICHT: Sicheres Passwort generieren (openssl rand -base64 24)
KC_ADMIN_PASSWORD=

# Netzwerk-Ports für Keycloak
# KC_HTTPS_PORT wird nicht gesetzt: TLS wird am Nginx terminiert,
# Keycloak hört intern nur auf HTTP (http-enabled=true in keycloak.conf.tpl).
KC_HTTP_PORT=8080
KC_JGROUPS_PORT=7800
# Management-Port (Health, Metrics) – seit Keycloak 25+ getrennt vom HTTP-Port
KC_MGMT_PORT=9000

# === Java ===
# Adoptium Temurin JDK Version (empfohlen für Keycloak Quarkus-Distribution)
JAVA_VERSION=21

# JVM-Heap-Einstellungen (anpassen je nach verfügbarem RAM)
# Empfehlung: Xmx = 50% des verfügbaren RAM, max. 4096m
JAVA_OPTS="-Xms512m -Xmx2048m"

# === SSH-Hardening (04-harden.sh) ===
# SSH-Port (Standard: 22). Änderung empfohlen für Produktiv-Systeme.
SSH_PORT=22

# Komma-separierte Admin-IPs, die SSH-Zugriff erhalten (leer = alle)
# Beispiel: ADMIN_IPS=10.0.0.1,10.0.0.2
ADMIN_IPS=

# === Monitoring (optional) ===
# IP der Monitoring-VM (mon01). Wird verwendet für:
#   - UFW-Regeln: Scraping-Ports (9100, 9187, 9113) von mon01 erlauben
#   - Prometheus: Scrape-Targets in prometheus.yml
# Leer lassen wenn kein Monitoring gewünscht.
MON_HOST=
