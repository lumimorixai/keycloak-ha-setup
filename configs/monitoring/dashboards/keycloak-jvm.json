{
  "id": null,
  "uid": "keycloak-jvm",
  "title": "Keycloak JVM",
  "description": "Heap, GC-Pausen, Threads, CPU, HikariCP Connection Pool",
  "tags": ["keycloak", "jvm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{job=\"keycloak\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Heap Used vs. Max",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", instance=~\"$instance\"}",
          "legendFormat": "used {{ instance }}"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", instance=~\"$instance\"}",
          "legendFormat": "max {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Non-Heap Memory",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"nonheap\", instance=~\"$instance\"}",
          "legendFormat": "used {{ instance }}"
        },
        {
          "expr": "jvm_memory_committed_bytes{area=\"nonheap\", instance=~\"$instance\"}",
          "legendFormat": "committed {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC-Pausen (max)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.2, "color": "yellow" },
              { "value": 0.5, "color": "red" }
            ]
          },
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_gc_pause_seconds_max{instance=~\"$instance\"}",
          "legendFormat": "{{ action }} {{ instance }}"
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU & Threads",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "gauge",
      "title": "Process CPU Usage",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"keycloak\", instance=~\"$instance\"}",
          "legendFormat": "{{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (Verlauf)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"keycloak\", instance=~\"$instance\"}",
          "legendFormat": "process {{ instance }}"
        },
        {
          "expr": "system_cpu_usage{job=\"keycloak\", instance=~\"$instance\"}",
          "legendFormat": "system {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live Threads",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{instance=~\"$instance\"}",
          "legendFormat": "live {{ instance }}"
        },
        {
          "expr": "jvm_threads_daemon_threads{instance=~\"$instance\"}",
          "legendFormat": "daemon {{ instance }}"
        }
      ]
    },
    {
      "type": "row",
      "title": "HikariCP Connection Pool",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Active Connections",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{instance=~\"$instance\"}",
          "legendFormat": "active {{ instance }}"
        },
        {
          "expr": "hikaricp_connections{instance=~\"$instance\"}",
          "legendFormat": "total {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending Connections",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending{instance=~\"$instance\"}",
          "legendFormat": "pending {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Idle & Timeout",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_idle{instance=~\"$instance\"}",
          "legendFormat": "idle {{ instance }}"
        },
        {
          "expr": "rate(hikaricp_connections_timeout_total{instance=~\"$instance\"}[5m]) * 60",
          "legendFormat": "timeouts/min {{ instance }}"
        }
      ]
    }
  ]
}
