{
  "id": null,
  "uid": "keycloak-overview",
  "title": "Keycloak Overview",
  "description": "Login-Rate, Registrierungen, Fehler, Token-Latenz, Cluster Health",
  "tags": ["keycloak"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{job=\"keycloak\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Login & Session Activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Erfolgreiche Logins / min",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{instance=~\"$instance\", event=\"login\", error=\"\"}[5m])) by (realm) * 60",
          "legendFormat": "{{ realm }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fehlgeschlagene Logins / min",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{instance=~\"$instance\", event=~\"login|login_error\", error!=\"\"}[5m])) by (realm) * 60",
          "legendFormat": "{{ realm }}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Registrierungen (letzte Stunde)",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(keycloak_user_events_total{instance=~\"$instance\", event=\"register\", error=\"\"}[1h]))",
          "legendFormat": "Registrierungen"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Token Refreshes / min",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{instance=~\"$instance\", event=\"refresh_token\", error=\"\"}[5m])) * 60",
          "legendFormat": "Refreshes"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Code-to-Token / min",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{instance=~\"$instance\", event=\"code_to_token\", error=\"\"}[5m])) * 60",
          "legendFormat": "Exchanges"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Login-Versuche gesamt / min",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{instance=~\"$instance\", event=~\"login|login_error\"}[5m])) * 60",
          "legendFormat": "Versuche"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "row",
      "title": "User-Bestand",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "User gesamt (alle Realms)",
      "description": "Quelle: Textfile-Collector keycloak-user-metrics.sh (SQL auf user_entity), nicht der Keycloak-/metrics-Endpoint.",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(keycloak_users_total)",
          "legendFormat": "User"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "type": "timeseries",
      "title": "User pro Realm",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "keycloak_users_total",
          "legendFormat": "{{ realm }}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Token-Endpoint p95 Latenz",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.2, "color": "yellow" },
              { "value": 0.5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{instance=~\"$instance\", uri=~\".*token.*\"}[5m])) by (le, instance))",
          "legendFormat": "p95 {{ instance }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request-Rate nach Status",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "5.." },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4.." },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\"}[5m])) by (status)",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request-Latenz (avg)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{instance=~\"$instance\"}[5m])) by (instance) / sum(rate(http_server_requests_seconds_count{instance=~\"$instance\"}[5m])) by (instance)",
          "legendFormat": "avg {{ instance }}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cluster Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Cluster Nodes UP",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 2, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job=\"keycloak\"} == 1)",
          "legendFormat": "Nodes UP"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Node-Status",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"keycloak\"}",
          "legendFormat": "{{ instance }}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "dtdurations" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"keycloak\", instance=~\"$instance\"}",
          "legendFormat": "{{ instance }}"
        }
      ],
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "timeseries",
      "title": "Keycloak Target Health",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 50, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"keycloak\"}",
          "legendFormat": "{{ instance }}"
        }
      ]
    }
  ]
}
