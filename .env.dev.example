# ==============================================================================
# Keycloak DEV Setup – Zentrale Konfiguration (2-Node-Variante)
# Kopiere diese Datei als .env und befülle alle Werte vor dem Deployment.
# WICHTIG: .env wird NIEMALS committed (steht in .gitignore).
# Passwörter generieren z.B. mit: openssl rand -base64 24
# ==============================================================================
#
# DEV-Topologie (2 VMs statt 4):
#
#   VM 1 (app01):               VM 2 (lb01):
#     PostgreSQL  :5432           Nginx        :443/:80
#     Keycloak    :8080  <----    Reverse Proxy
#                 :9000           Certbot (Let's Encrypt)
#     node_exp    :9100           Prometheus   :9090
#     pg_exp      :9187           Grafana      :3000
#                                 Alertmanager :9093
#                                 nginx_exp    :9113
#                                 node_exp     :9100
#
# Kein Clustering: Einzelne Keycloak-Instanz.
# DB und KC co-located auf app01. Monitoring auf lb01 statt separater mon01.
# ==============================================================================

# === Domain & TLS ===
# Öffentlicher FQDN, unter dem Keycloak erreichbar ist.
# DNS muss vor 03-setup-nginx.sh auf lb01 zeigen (Certbot-Voraussetzung).
KC_DOMAIN=dev-auth.example.com

# E-Mail für Let's Encrypt ACME-Benachrichtigungen (Ablauf-Warnungen)
ACME_EMAIL=admin@example.com

# === VM IPs (private/interne Netzwerk-IPs) ===
# DEV: DB läuft auf app01 – externe IP verwenden, damit Prometheus auf lb01
# den postgres_exporter scrapen kann. NICHT 127.0.0.1 verwenden!
DB_HOST=<APP01_IP>
# DEV: Beide Node-IPs identisch → Single-Node, kein Cluster.
# Hier die IP von app01 eintragen.
KC_NODE1_IP=<APP01_IP>
KC_NODE2_IP=<APP01_IP>
# IP von lb01
LB_HOST=<LB01_IP>

# === PostgreSQL ===
DB_NAME=keycloak
DB_USER=keycloak
# PFLICHT: Sicheres Passwort generieren (openssl rand -base64 24)
DB_PASSWORD=

# === Keycloak ===
# Pinned Version – Änderung erfordert erneutes Ausführen von 02-setup-keycloak.sh
KC_VERSION=26.5.5

# Initialer Admin-User (wird NUR beim allerersten Start ausgewertet,
# solange noch kein Admin in der DB existiert).
KC_ADMIN_USER=admin
# PFLICHT: Sicheres Passwort generieren (openssl rand -base64 24)
KC_ADMIN_PASSWORD=

# Netzwerk-Ports für Keycloak
# KC_HTTPS_PORT wird nicht gesetzt: TLS wird am Nginx terminiert,
# Keycloak hört intern nur auf HTTP (http-enabled=true in keycloak.conf.tpl).
KC_HTTP_PORT=8080
KC_JGROUPS_PORT=7800
# Management-Port (Health, Metrics) – seit Keycloak 25+ getrennt vom HTTP-Port
KC_MGMT_PORT=9000

# === Java ===
# Adoptium Temurin JDK Version (empfohlen für Keycloak Quarkus-Distribution)
JAVA_VERSION=21

# JVM-Heap-Einstellungen (DEV: reduziert, da nur Single-Node)
JAVA_OPTS="-Xms256m -Xmx1024m"

# === SSH-Hardening (04-harden.sh) ===
# SSH-Port (Standard: 22). Änderung empfohlen für Produktiv-Systeme.
SSH_PORT=22

# Komma-separierte Admin-IPs, die SSH-Zugriff erhalten (leer = alle)
# Beispiel: ADMIN_IPS=10.0.0.1,10.0.0.2
ADMIN_IPS=

# === Monitoring (optional) ===
# DEV: Monitoring läuft auf lb01 → gleiche IP wie LB_HOST
MON_HOST=<LB01_IP>
